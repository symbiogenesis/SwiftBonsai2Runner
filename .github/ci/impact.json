{
  "shared": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/**",
    ".github/ci/**",
    "tools/ci/**",
    ".github/workflows/foundation.yml",
    ".github/workflows/premerge.yml",
    ".github/actions/rust-toolchain/**",
    ".github/actions/check-rust/**",
    ".github/actions/native-speech/**",
    "config/rust-packages.json",
    "tools/ci/src/checks/**",
    ".github/actions/ci-tool/**"
  ],
  "ignored": [
    "*.md",
    "docs/**",
    ".gitignore"
  ],
  "package_inputs": {
    "bonsai-cpu-policy": [
      "config/runtime.lock.json",
      "config/swift-assessment.lock.json",
      "config/swift-lora.lock.json",
      "config/swift.ptq1-export.json",
      "config/profiles/reference-cpu.json"
    ],
    "bonsai-broker": [
      "config/runtime.lock.json",
      "config/swift-assessment.lock.json",
      "config/swift.metadata.json",
      "config/profiles/reference-cpu.json",
      "config/prism-inference.lock.json"
    ],
    "bonsai-tools": [
      "LICENSE",
      "NOTICE",
      "config/runtime.lock.json",
      "config/swift-assessment.lock.json",
      "config/swift-lora.lock.json",
      "config/swift.ptq1-export.json",
      "config/swift-lora.qualification.json",
      "config/swift-lora.app-qualification.json",
      "config/swift.metadata.json",
      "tests/fixtures/lora-qualification-v1.json",
      "src/speech-asr/model.lock.json",
      "src/speech-tts/model*.lock.json",
      "config/native-speech.lock.json",
      "config/prism-inference.lock.json"
    ]
  },
  "groups": {
    "broker": {
      "packages": [
        "bonsai-broker",
        "bonsai-speech-service"
      ]
    },
    "ui": {
      "packages": [
        "bonsai-chat"
      ]
    },
    "speech_asr": {
      "packages": [
        "bonsai-speech-asr"
      ]
    },
    "speech_tts": {
      "packages": [
        "bonsai-speech-tts"
      ]
    },
    "broker_checks": {
      "groups": [
        "broker",
        "ui"
      ]
    },
    "speech": {
      "groups": [
        "speech_asr",
        "speech_tts"
      ]
    },
    "maintenance": {
      "packages": [
        "*"
      ],
      "exclude_packages": [
        "bonsai-broker",
        "bonsai-chat",
        "bonsai-speech-asr",
        "bonsai-speech-tts",
        "bonsai-speech-service"
      ],
      "groups": [
        "tools"
      ]
    },
    "tools": {
      "packages": [
        "bonsai-tools"
      ],
      "groups": [
        "scripts",
        "release",
        "speech"
      ],
      "paths": [
        ".github/actions/bonsai-tools/**",
        ".github/actions/use-bonsai-tools/**"
      ]
    },
    "rust_lanes": {
      "groups": [
        "broker_checks",
        "speech",
        "maintenance"
      ]
    },
    "foundation_scripts": {
      "packages": [
        "bonsai-tools"
      ],
      "paths": [
        "tools/hexagon/**",
        "config/hexagon-experiment.lock.json",
        "config/hexagon-signed-q2-candidate.lock.json",
        ".github/workflows/hexagon-qualification.yml",
        "config/hexagon-dispatch.lock.json",
        "config/native-speech.lock.json",
        ".github/workflows/tts-evaluation.yml",
        "tools/canary-asr/model.lock.json",
        "tools/canary-asr/tokenizer.lock.json",
        "tools/qwen-tts/model.lock.json",
        ".github/workflows/ptq1-packing-qualification.yml",
        "tools/native-reference/**",
        ".github/workflows/native-ptq1-numerics.yml",
        "docs/evidence/headless-publisher-startup.json",
        "docs/runtime-candidates/headless-ucrt-argv.json",
        "tests/fixtures/**",
        "config/prism-inference.lock.json",
        "config/model.metadata.json"
      ]
    },
    "native_scripts": {
      "packages": [
        "bonsai-tools"
      ],
      "paths": [
        ".github/workflows/x2-cpu-evaluation.yml",
        "tests/fixtures/**",
        ".github/workflows/swift-lora-qualification.yml",
        ".github/workflows/swift-ptq1-screen.yml",
        ".github/workflows/native-runtime-acceptance.yml"
      ]
    },
    "scripts": {
      "groups": [
        "foundation_scripts",
        "native_scripts"
      ]
    },
    "release": {
      "packages": [
        "bonsai-tools"
      ],
      "paths": [
        "config/runtime.lock.json",
        "config/swift-assessment.lock.json",
        "config/swift-lora.lock.json",
        "config/swift.ptq1-export.json",
        "config/profiles/**"
      ]
    }
  },
  "matrices": {
    "broker_lanes": {
      "core": "broker",
      "ui": "ui"
    },
    "speech_lanes": {
      "asr": "speech_asr",
      "tts": "speech_tts"
    },
    "script_lanes": {
      "foundation": "foundation_scripts",
      "native": "native_scripts"
    }
  },
  "workflows": {
    "foundation": {
      "broker": "broker_checks",
      "speech": "speech",
      "maintenance": "maintenance",
      "foundation-tests": "scripts",
      "release-integration": "release"
    }
  }
}
