ows-msvc.receipt.json"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/assets/674418457","id":674418457,"node_id":"RA_kwDOVWipD84oMs8Z","name":"prism-inference-0.1.1-x86_64-pc-windows-msvc.zip","label":"","uploader":{"login":"symbiogenesis","id":1724472,"node_id":"MDQ6VXNlcjE3MjQ0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1724472?v=4","gravatar_id":"","url":"https://api.github.com/users/symbiogenesis","html_url":"https://github.com/symbiogenesis","followers_url":"https://api.github.com/users/symbiogenesis/followers","following_url":"https://api.github.com/users/symbiogenesis/following{/other_user}","gists_url":"https://api.github.com/users/symbiogenesis/gists{/gist_id}","starred_url":"https://api.github.com/users/symbiogenesis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/symbiogenesis/subscriptions","organizations_url":"https://api.github.com/users/symbiogenesis/orgs","repos_url":"https://api.github.com/users/symbiogenesis/repos","events_url":"https://api.github.com/users/symbiogenesis/events{/privacy}","received_events_url":"https://api.github.com/users/symbiogenesis/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":3140882,"digest":"sha256:9a3c525edf61abea9d581ef9d64fba95048e40625487dd1347f2b7057ec421c3","download_count":2,"created_at":"2026-10-25T07:45:12Z","updated_at":"2026-10-25T07:45:12Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.1/prism-inference-0.1.1-x86_64-pc-windows-msvc.zip"}],"tarball_url":"https://api.github.com/repos/symbiogenesis/prism-inference/tarball/v0.1.1","zipball_url":"https://api.github.com/repos/symbiogenesis/prism-inference/zipball/v0.1.1","body":"Prism Inference is an independent Rust CPU runtime for Prism-compatible GGUF models. The first supported generation path is Swift/Bonsai; broader Prism inference is in scope and deferred.\n\nThis experimental release provides prebuilt Windows ARM64 and x64 versions of prism-inference, prism-inference-server, bonsai-token-worker, bonsai-swift-worker and bonsai-gguf. SwiftBonsai consumes the server without compiling the engine. The runtime and server crates are published as version 0.1.1 on crates.io.\n\nThe included receipt pins source revision, compiler, archive hash and every installed file. Runtime implementation, licenses and detailed CLI/ownership/validation guides are in the repository. Full-model numerical parity and device performance qualification remain open.\n\nThis revision also fixes feature-disabled test documentation checks. Complete Windows suites and the Linux native overlay run in the main-branch Foundation workflow.\nRuntime Foundation passed on ARM64, x64 and Linux ARM64: https://github.com/symbiogenesis/prism-inference/actions/runs/40173247206\n"}]