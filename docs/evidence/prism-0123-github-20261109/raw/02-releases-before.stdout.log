nt_type":"application/json","state":"uploaded","size":1976,"digest":"sha256:a4b2cba20b41ff0a6a5a0001dd8510f3d0ffe58ad54348bceccc2bd46b8bcd0a","download_count":2,"created_at":"2026-10-30T07:08:32Z","updated_at":"2026-10-30T07:08:32Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.8/prism-inference-0.1.8-aarch64-pc-windows-msvc.receipt.json"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/assets/691268833","id":691268833,"node_id":"RA_kwDOVWipD84pM-zh","name":"prism-inference-0.1.8-aarch64-pc-windows-msvc.zip","label":"","uploader":{"login":"symbiogenesis","id":1724472,"node_id":"MDQ6VXNlcjE3MjQ0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1724472?v=4","gravatar_id":"","url":"https://api.github.com/users/symbiogenesis","html_url":"https://github.com/symbiogenesis","followers_url":"https://api.github.com/users/symbiogenesis/followers","following_url":"https://api.github.com/users/symbiogenesis/following{/other_user}","gists_url":"https://api.github.com/users/symbiogenesis/gists{/gist_id}","starred_url":"https://api.github.com/users/symbiogenesis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/symbiogenesis/subscriptions","organizations_url":"https://api.github.com/users/symbiogenesis/orgs","repos_url":"https://api.github.com/users/symbiogenesis/repos","events_url":"https://api.github.com/users/symbiogenesis/events{/privacy}","received_events_url":"https://api.github.com/users/symbiogenesis/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":3014310,"digest":"sha256:7e97e8a14778ff334df4b6f4cc41c1128ddafc48b02dd069617af7895a1d3487","download_count":7,"created_at":"2026-10-30T07:08:32Z","updated_at":"2026-10-30T07:08:33Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.8/prism-inference-0.1.8-aarch64-pc-windows-msvc.zip"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/assets/691268837","id":691268837,"node_id":"RA_kwDOVWipD84pM-zl","name":"prism-inference-0.1.8-x86_64-pc-windows-msvc.receipt.json","label":"","uploader":{"login":"symbiogenesis","id":1724472,"node_id":"MDQ6VXNlcjE3MjQ0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1724472?v=4","gravatar_id":"","url":"https://api.github.com/users/symbiogenesis","html_url":"https://github.com/symbiogenesis","followers_url":"https://api.github.com/users/symbiogenesis/followers","following_url":"https://api.github.com/users/symbiogenesis/following{/other_user}","gists_url":"https://api.github.com/users/symbiogenesis/gists{/gist_id}","starred_url":"https://api.github.com/users/symbiogenesis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/symbiogenesis/subscriptions","organizations_url":"https://api.github.com/users/symbiogenesis/orgs","repos_url":"https://api.github.com/users/symbiogenesis/repos","events_url":"https://api.github.com/users/symbiogenesis/events{/privacy}","received_events_url":"https://api.github.com/users/symbiogenesis/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/json","state":"uploaded","size":1974,"digest":"sha256:fa272498203dc413b9393ee098b04acc7ce64054d4a78c7028af39711fdab046","download_count":2,"created_at":"2026-10-30T07:08:32Z","updated_at":"2026-10-30T07:08:32Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.8/prism-inference-0.1.8-x86_64-pc-windows-msvc.receipt.json"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/assets/691268841","id":691268841,"node_id":"RA_kwDOVWipD84pM-zp","name":"prism-inference-0.1.8-x86_64-pc-windows-msvc.zip","label":"","uploader":{"login":"symbiogenesis","id":1724472,"node_id":"MDQ6VXNlcjE3MjQ0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1724472?v=4","gravatar_id":"","url":"https://api.github.com/users/symbiogenesis","html_url":"https://github.com/symbiogenesis","followers_url":"https://api.github.com/users/symbiogenesis/followers","following_url":"https://api.github.com/users/symbiogenesis/following{/other_user}","gists_url":"https://api.github.com/users/symbiogenesis/gists{/gist_id}","starred_url":"https://api.github.com/users/symbiogenesis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/symbiogenesis/subscriptions","organizations_url":"https://api.github.com/users/symbiogenesis/orgs","repos_url":"https://api.github.com/users/symbiogenesis/repos","events_url":"https://api.github.com/users/symbiogenesis/events{/privacy}","received_events_url":"https://api.github.com/users/symbiogenesis/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":3277024,"digest":"sha256:11be7848c721583a98f1be9c22f14b10c9b2aeb4daaaa52a79fcecc762f99b1a","download_count":3,"created_at":"2026-10-30T07:08:32Z","updated_at":"2026-10-30T07:08:33Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.8/prism-inference-0.1.8-x86_64-pc-windows-msvc.zip"}],"tarball_url":"https://api.github.com/repos/symbiogenesis/prism-inference/tarball/v0.1.8","zipball_url":"https://api.github.com/repos/symbiogenesis/prism-inference/zipball/v0.1.8","body":"Prism Inference 0.1.8 corrects private-child read-path validation for the existing exact-file AppContainer grants. It uses the reviewed read-only consumer helper, pinned to SwiftBonsai2Runner abe04b4, instead of requiring volume-root metadata that PSEC can deny. Private-key reading retains its read handle and exact 64-byte lowercase-hex validation.\n\nStartup failures now report only a fixed stage, I/O error kind and optional numeric OS code. Arbitrary error messages, paths, arguments and credential values are never formatted into these diagnostics. Filesystem grants, resource limits, inference arithmetic and model defaults are unchanged.\n\nSource: fce300b94234c2dd70756dd4bbc33ea703848cb6.\nFoundation: https://github.com/symbiogenesis/prism-inference/actions/runs/41017335054 (passed).\nRuntime conformance: https://github.com/symbiogenesis/prism-inference/actions/runs/41017335160 (passed).\n\nBoth bundles and receipts are from that exact Foundation run. Runner's offline archive/source/file/PE review passed for the ARM64 candidate; both platforms' complete ZIP contents and file digests were independently verified. The helper source is pinned exactly and retained separately for review.\n\nThe server is delivered through GitHub binaries and exact source checkouts. Its crates.io publication is disabled until the reviewed helper API has a registry release; the independent core runtime crate's publication policy is unchanged.\n\nThe previous 0.1.7 required-container application attempt failed before verified readiness. Application acceptance of this replacement still requires the separate five-minute owner-device smoke after Runner pin integration. PTQ1 remains diagnostic only; this prerelease does not qualify complete answers, adapter authoring basis, full context/output, sustained resources, performance, quality or daily isolation. The 0.1.7 files remain available and unchanged.\r\n\nBounded application evidence: Runner main 1540297 passed required-sandbox PTQ1/approved-adapter readiness, one scale-1.3 streamed response and owned Job/listener cleanup: https://github.com/symbiogenesis/SwiftBonsai2Runner/actions/runs/41020705958 . The owner job took 180 seconds. The four-token cap yielded one reported output token, three visible UTF-8 bytes and natural stop; optional zero-scale and invalid-scale/reuse checks were skipped. This does not qualify broader lifecycle, quality or default promotion.\n"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/428708817","assets_url":"https://api.github.com/repos/symbiogenesis/prism-inference