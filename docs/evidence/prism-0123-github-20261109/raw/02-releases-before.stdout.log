26-10-26T04:17:25Z","updated_at":"2026-10-26T04:17:26Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.2/prism-inference-0.1.2-x86_64-pc-windows-msvc.receipt.json"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/assets/676983955","id":676983955,"node_id":"RA_kwDOVWipD84oWfST","name":"prism-inference-0.1.2-x86_64-pc-windows-msvc.zip","label":"","uploader":{"login":"symbiogenesis","id":1724472,"node_id":"MDQ6VXNlcjE3MjQ0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1724472?v=4","gravatar_id":"","url":"https://api.github.com/users/symbiogenesis","html_url":"https://github.com/symbiogenesis","followers_url":"https://api.github.com/users/symbiogenesis/followers","following_url":"https://api.github.com/users/symbiogenesis/following{/other_user}","gists_url":"https://api.github.com/users/symbiogenesis/gists{/gist_id}","starred_url":"https://api.github.com/users/symbiogenesis/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/symbiogenesis/subscriptions","organizations_url":"https://api.github.com/users/symbiogenesis/orgs","repos_url":"https://api.github.com/users/symbiogenesis/repos","events_url":"https://api.github.com/users/symbiogenesis/events{/privacy}","received_events_url":"https://api.github.com/users/symbiogenesis/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/zip","state":"uploaded","size":3166456,"digest":"sha256:9601c5bd5cf01eaff0fed12034a962b1aeec9b349ceec8507f36321d2d79a3a1","download_count":2,"created_at":"2026-10-26T04:17:25Z","updated_at":"2026-10-26T04:17:26Z","browser_download_url":"https://github.com/symbiogenesis/prism-inference/releases/download/v0.1.2/prism-inference-0.1.2-x86_64-pc-windows-msvc.zip"}],"tarball_url":"https://api.github.com/repos/symbiogenesis/prism-inference/tarball/v0.1.2","zipball_url":"https://api.github.com/repos/symbiogenesis/prism-inference/zipball/v0.1.2","body":"Prism Inference 0.1.2 replaces the PQ2/PTQ1 GGML process adapter with Rust and removes its C++ implementation. The binary protocol, production ggml operations, resource bounds and executable name are preserved.\n\nBefore/after validation compared the original and Rust executables across 40 protocol cases, all 15 original PQ2 shapes and 2,560,000 PTQ1 positions. The original request and response files matched byte for byte. Windows ARM64 focused PQ2 and PTQ1 acceptance passed.\n\nSource revision: 1f061e10cdb1ca79a8ce1219e0aa206fd5ae4a42.\n\nChecked Windows ARM64 and x64 bundles contain the CLI, token worker, Swift worker, private inference server, GGUF tool, licenses and source receipts. Models are separate downloads. Full-model and device qualification remains described in the repository roadmap.\n\nValidation:\n- Foundation: https://github.com/symbiogenesis/prism-inference/actions/runs/40265733238\n- Runtime conformance: https://github.com/symbiogenesis/prism-inference/actions/runs/40267655152\n- ARM64 PQ2: https://github.com/symbiogenesis/prism-inference/actions/runs/40265363899\n- ARM64 PTQ1: https://github.com/symbiogenesis/prism-inference/actions/runs/40265365927\nLatest full-conformance status at publication: in_progress at 611adf1e4f2e4bfbcb180a736a77cb58e1c9af27. Intervening changes affect CI and fixture caching; the released runtime, server, codec and GGML adapter sources are identical to the checked release revision.\n"},{"url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/423220125","assets_url":"https://api.github.com/repos/symbiogenesis/prism-inference/releases/423220125/assets","upload_url":"https://uploads.github.com/repos/symbiogenesis/prism-inference/releases/423220125/assets{?name,label}","html_url":"https://github.com/symbiogenesis/prism-inference/releases/tag/v0.1.1","id":423220125,"author":{"login":"symbiogenesis","id":1724472,"node_id":"MDQ6VXNlcjE3MjQ0NzI=","avatar_url":"https://avatars.githubusercontent.com/u/1724