  "families": [
    {
      "id": "hexagon-qaic",
      "obligations": [
        "Preserve original generated start/stop wire observations and independent Rust encoding, exact pinned public imports, notices and source provenance.",
        "Public generator observations do not qualify SDK equivalence or signed device execution."
      ],
      "retirementQualified": false
    },
    {
      "id": "hexagon-windows-abi",
      "obligations": [
        "Preserve every public-header Windows ARM64 size/alignment/offset/flag/function-signature assertion and distinct timed/nonblocking queue mock.",
        "Retain independent wire, SDK and Windows ABI controls until all owning replay and hosted gates pass."
      ],
      "retirementQualified": false
    },
    {
      "id": "native-asr",
      "obligations": [
        "Preserve all 1718 native registry-package identities and exact model/tokenizer/frontend/numerical/transcript/state/lifecycle obligations before native-engine removal.",
        "Rust service and actual-model parity, microphone integration, quality, cancellation and resource acceptance remain separate."
      ],
      "retirementQualified": false
    },
    {
      "id": "publisher-runtime",
      "obligations": [
        "Preserve immutable publisher source/DLL/archive identities, rollback profiles, PTQ1 capture inputs and independent exact numerical/state controls.",
        "Failed exact-source archive HTTP 404 intake remains closed; no substitution or implicit fallback."
      ],
      "retirementQualified": false
    },
    {
      "id": "compiler-provisioning",
      "obligations": [
        "Remove native compiler/CMake/Ninja/source/cache/build edges only after replacement coverage and hosted no-project-C++ builds pass."
      ],
      "retirementQualified": false
    },
    {
      "id": "msvc-unwind",
      "obligations": [
        "Preserve preparation-peer panic recovery, scoped destruction, worker draining and cleanup while replacing embedded MSVC C++ exception support.",
        "Static CRT linkage and panic-abort do not establish a qualified Rust unwinder."
      ],
      "retirementQualified": false
    }
  ],
