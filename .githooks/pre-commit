#!/bin/sh
# Validate the index: unstaged repairs must not conceal a broken workflow commit.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoLogo -NoProfile -NonInteractive -File tools/ci/check_staged_workflows.ps1
fi
echo 'Commit blocked: PowerShell 7.6+ is required for the offline staged workflow startup check.' >&2
exit 1
